# ===========================================
# Application
# ===========================================
# Host port the container publishes (docker-compose*.yml -> nginx :80).
APP_PORT=3000

# ===========================================
# Registry image (docker-compose.prod.yml only)
# ===========================================
# Frontend image to PULL on the server (`make prod deploy`). CI builds and pushes it
# (.github/workflows/build-push.yml); the server only pulls. Pin a reproducible
# deploy with the sha- tag, e.g.
#   FRONTEND_IMAGE=ghcr.io/igorkhaylov/react-template:sha-<full-sha>
# A moving :latest also works but drifts on the next push.
FRONTEND_IMAGE=ghcr.io/igorkhaylov/react-template:latest

# ===========================================
# Frontend configuration (VITE_* vars)
# ===========================================
# Two delivery modes:
#   - Docker image: injected at CONTAINER START — docker/90-env-config.sh writes
#     them into env-config.js, so the same image runs in any environment and
#     changing a value only needs a container restart, not a rebuild.
#   - Plain `npm run build`: baked in at BUILD time from the Vite .env files.
# Resolution order lives in src/env.ts (window.__ENV__ -> import.meta.env -> default).
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=MyApp
VITE_DEFAULT_LOCALE=ru
